# Store an encrypted credential outside the writable state directory:
#   sudo systemd-creds encrypt /var/lib/cf-r2-manager/master.key \
#     /etc/cf-r2-manager/master-key.cred
# Then remove the plaintext source only after `doctor` succeeds with this override.

[Service]
LoadCredential=
LoadCredentialEncrypted=master-key:/etc/cf-r2-manager/master-key.cred
